# Copie para .env e preencha os valores reais.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bets
DB_USER=bets_user
DB_PASSWORD=CHANGE_ME

# Segredo do header X-Admin-Api-Key
ADMIN_API_KEY=CHANGE_ME

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
